# 见 docs/ARCHITECTURE.md §6.2
DATABASE_URL=mysql://root:change-me@mysql:3306/repolens
MYSQL_ROOT_PASSWORD=change-me
REDIS_URL=redis://redis:6379
# LLM 供应商:fake | deepseek(WEEK2_PLAN D1 已决 DeepSeek)
# 当前代码(packages/agent/src/llm/config.ts readLlmConfig)只接受 fake,填 deepseek 会启动失败;
# deepseek 要等真实客户端 PR(T-210b)合并后才生效。
LLM_PROVIDER=fake
# LLM_PROVIDER=deepseek            # T-210b 合并后才生效
# DEEPSEEK_API_KEY=<your-key>      # 只放本地 .env,不要提交
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型 id:readLlmConfig 目前不读取任何模型变量(fake 下固定为 "fake")。
# 下面两个变量名沿用 ARCHITECTURE.md §6.2,T-210b 确定实际读取的变量名后再对齐(待确认)。
LLM_CHAT_MODEL=deepseek-flash
LLM_SUMMARY_MODEL=deepseek-flash
# embedding 供应商待定(WEEK2_PLAN D4),当前代码未读取此变量
EMBEDDING_MODEL=
# 只读 PAT,可选
GITHUB_TOKEN=
MAX_REPO_MB=300
# 每来源每小时:新仓库(真正入队)上限;复用已有结果、被拒绝、出错不计
RATE_LIMIT_NEW_REPOS_PER_HOUR=5
# 每来源每小时:POST /api/analyze 总次数上限(含复用、被拒绝、出错),超出 429 RATE_LIMITED
RATE_LIMIT_SUBMITS_PER_HOUR=60
MAX_FILES=5000
DAILY_LLM_BUDGET_CENTS=500
# 单次分析任务的 LLM 预算(美分,WEEK2_PLAN D2)
LLM_TASK_BUDGET_CENTS=30
WORKER_CONCURRENCY=2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=code_chunks
API_PORT=4000
