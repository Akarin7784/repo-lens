# 见 docs/ARCHITECTURE.md §6.2
DATABASE_URL=mysql://root:change-me@mysql:3306/repolens
MYSQL_ROOT_PASSWORD=change-me
REDIS_URL=redis://redis:6379
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o
LLM_SUMMARY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# 只读 PAT,可选
GITHUB_TOKEN=
MAX_REPO_MB=300
# 每来源每小时:新仓库(真正入队)上限;复用已有结果、被拒绝、出错不计
RATE_LIMIT_NEW_REPOS_PER_HOUR=5
# 每来源每小时:POST /api/analyze 总次数上限(含复用、被拒绝、出错),超出 429 RATE_LIMITED
RATE_LIMIT_SUBMITS_PER_HOUR=60
MAX_FILES=5000
DAILY_LLM_BUDGET_CENTS=500
WORKER_CONCURRENCY=2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=code_chunks
API_PORT=4000
# 前端聚合边透明度 (0,1],默认 0.3。构建期变量:内联进客户端包,改值需重新构建(pnpm build / docker compose up --build)
NEXT_PUBLIC_AGG_EDGE_OPACITY=0.3
