# 见 docs/ARCHITECTURE.md §6.2
DATABASE_URL=mysql://root:change-me@mysql:3306/repolens
MYSQL_ROOT_PASSWORD=change-me
REDIS_URL=redis://redis:6379
# LLM 供应商:fake | deepseek(WEEK2_PLAN D1 已决 DeepSeek)。默认 fake,不联网、不需要 key。
# 改成 deepseek 时必须设置 DEEPSEEK_API_KEY,否则启动报错。
LLM_PROVIDER=fake
# DeepSeek(OpenAI 兼容,只在 LLM_PROVIDER=deepseek 时读取)
# key 只放本地 .env,不要提交
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型 id(只在 deepseek 下读取;fake 下固定为 "fake")。默认都是 deepseek-flash。
# LLM_CHAT_MODEL:repo 摘要与问答;LLM_SUMMARY_MODEL:file/dir/module 摘要
LLM_CHAT_MODEL=deepseek-flash
LLM_SUMMARY_MODEL=deepseek-flash
# embedding(T-214,D4 定稿:本地 multilingual-e5-small fp32,384 维,只在 worker 里跑)
# EMBEDDER=onnx 用镜像内模型(构建时下载,峰值内存约 2.5 GB,演示机至少 4 GB);fake 为确定性假向量(CI/测试)
EMBEDDER=onnx
# 留空为 Xenova/multilingual-e5-small
EMBEDDING_MODEL=
# 每批送模型的切块数(1–256),调小可降低峰值内存
EMBEDDING_BATCH_SIZE=16
# 同 commit 向量化锁 TTL(秒,≥60);持有者每 TTL/3 续期,TTL 只决定崩溃后多久释放;留空默认 300
EMBEDDING_LOCK_TTL_SEC=
# 等待同 commit 另一任务完成向量化的上限(秒,≥1);超时本任务 embeddingStatus=failed;留空默认 3600
EMBEDDING_LOCK_MAX_WAIT_SEC=
# worker 容器 CPU 上限(docker compose 读取;默认 2,不得超过宿主机核数;4 核演示机建议 2~3)
WORKER_CPUS=2
# 构建 worker 镜像时是否下载模型(1/0);设 0 时只能用 EMBEDDER=fake
EMBEDDING_MODEL_DOWNLOAD=1
# 只读 PAT,可选
GITHUB_TOKEN=
MAX_REPO_MB=300
# 每来源每小时:新仓库(真正入队)上限;复用已有结果、被拒绝、出错不计
RATE_LIMIT_NEW_REPOS_PER_HOUR=5
# 每来源每小时:POST /api/analyze 总次数上限(含复用、被拒绝、出错),超出 429 RATE_LIMITED
RATE_LIMIT_SUBMITS_PER_HOUR=60
MAX_FILES=5000
# 全站每日 LLM 预算(美分,按 UTC 自然日);0 表示禁止调用模型(只用缓存);非法值会让 api/worker 启动失败
DAILY_LLM_BUDGET_CENTS=500
# 单次分析任务的 LLM 预算(美分,WEEK2_PLAN D2)
LLM_TASK_BUDGET_CENTS=30
WORKER_CONCURRENCY=2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=code_chunks
API_PORT=4000
# 前端聚合边透明度 (0,1],默认 0.3。构建期变量:内联进客户端包,改值需重新构建(pnpm build / docker compose up --build)
NEXT_PUBLIC_AGG_EDGE_OPACITY=0.3
