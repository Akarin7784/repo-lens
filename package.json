{
  "name": "repolens",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "tree-sitter-typescript>tree-sitter": "0.22",
        "tree-sitter-javascript>tree-sitter": "0.22"
      }
    }
  }
}
